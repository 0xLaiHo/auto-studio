    {
      "dot": "cyan",
      "title": "One interface for the Agent",
      "items": [
        "The model produces canonical ToolRequest values, never shell commands or raw plugin payloads",
        "Registry descriptors expose validated schemas and capability snapshots",
        "Adapters keep Music IR, audio engine, plugin, and MCP protocols out of Agent logic"
      ]
    },
    {
      "dot": "emerald",
      "title": "One durable execution path",
      "items": [
        "Policy and one-time Approval run before side effects",
        "ToolExecution is persisted before invoke and records normalized results",
        "Revision checks and atomic commit prevent partial or duplicate project edits"
      ]
    },
    {
      "dot": "violet",
      "title": "Progressive rollout",
      "items": [
        "M3 instantiates the minimum local composition, render, and analysis tool set",
        "No Music Provider or prompt-to-WAV external job exists in the product runtime",
        "Generic MCP remains later and does not block the local music-quality Gate"
      ]
    }
