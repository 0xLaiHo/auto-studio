  "sections": [
    {
      "id": "record",
      "label": "Recording",
      "start_bar": 1,
      "length_bars": 8,
      "intent": "sparse broken chords, A minor voicings, cello introduces hesitant motif, very quiet sustained strings only last two bars, off-beat ticks, high air, low root"
    },
    {
      "id": "hesitate",
      "label": "Hesitation",
      "start_bar": 9,
      "length_bars": 8,
      "intent": "repeated suspended chords avoid resolution, cello varies motif leaves phrases unfinished, slow string swells with minor second movement, pulse slightly more present, air movement, bass alternates root and fifth"
    },
    {
      "id": "delete",
      "label": "Delete",
      "start_bar": 17,
      "length_bars": 4,
      "intent": "sparse bars around delete moment: first bar silence, then piano single isolated note, cello long held harmonic, strings and pulse rest, one soft air swell, low support rest"
    },
    {
      "id": "act",
      "label": "Act",
      "start_bar": 21,
      "length_bars": 12,
      "intent": "steadier piano ostinato, cello develops motif into forward-moving ascending line, richer sustained string pads, steady soft offbeat pulse, consistent air bed, grounded but restrained bass"
    },
    {
      "id": "afterthought",
      "label": "Afterthought",
      "start_bar": 33,
      "length_bars": 4,
      "intent": "piano fragment of opening chord fades, cello returns to original motif softly incomplete, thin sustained string note fades, single pulse on last beat then silence, air fades to nothing, low A held while fading"
    }
  ],
