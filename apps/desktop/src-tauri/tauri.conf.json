{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auto Studio",
  "version": "0.1.0",
  "identifier": "studio.autostudio.desktop",
  "build": {
    "beforeDevCommand": "cargo build -p core-daemon && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cargo build -p core-daemon --release && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Auto Studio",
        "width": 1180,
        "height": 760,
        "minWidth": 880,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": false
  }
}
